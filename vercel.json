{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/server.ts"
    },
    {
      "src": "/Resume.pdf",
      "dest": "frontend/public/Resume.pdf"
    },
    {
      "src": "/favicon.png",
      "dest": "frontend/public/favicon.png"
    },
    {
      "src": "/profile_pic.png",
      "dest": "frontend/public/profile_pic.png"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}